    <script src="/src/js/firebase-config.js"></script>
    <script>
        // Load student dashboard
        function loadStudentDashboard() {
            const studentData = localStorage.getItem('studentData');
            
            if (!studentData) {
                showError();
                return;
            }
            
            try {
                const student = JSON.parse(studentData);
                
                // Hide loading, show content
                document.getElementById('loadingMessage').style.display = 'none';
                document.getElementById('dashboardContent').style.display = 'block';
                
                // Display student information
                document.getElementById('studentName').textContent = `Welcome back, ${student.studentName}!`;
                document.getElementById('accessCodeDisplay').textContent = student.accessCode;
                
                // Display package information
                const packageNames = {
                    149: 'PSP Basic',
                    249: 'PSP Professional', 
                    349: 'PSP Elite'
                };
                document.getElementById('packageType').textContent = packageNames[student.packageAmount] || 'Unknown Package';
                
                // Display expiry information
                if (student.daysRemaining !== undefined) {
                    const daysRemaining = student.daysRemaining;
                    document.getElementById('daysRemaining').textContent = `${daysRemaining} days`;
                    
                    // Color code based on days remaining
                    if (daysRemaining < 7) {
                        document.getElementById('daysRemaining').style.color = '#dc2626';
                    } else if (daysRemaining < 30) {
                        document.getElementById('daysRemaining').style.color = '#f59e0b';
                    } else {
                        document.getElementById('daysRemaining').style.color = '#059669';
                    }
                    
                    // Show warning if less than 30 days
                    if (daysRemaining < 30) {
                        document.getElementById('expiryWarning').style.display = 'block';
                    }
                }
                
                if (student.expiryDate) {
                    const expiryDate = student.expiryDate.toDate();
                    document.getElementById('expiryDate').textContent = `Until ${expiryDate.toLocaleDateString()}`;
                }
                
                // Update session time
                localStorage.setItem('studentSession', Date.now().toString());
                
            } catch (error) {
                console.error('Error loading dashboard:', error);
                showError();
            }
        }
        
        function showError() {
            document.getElementById('loadingMessage').style.display = 'none';
            document.getElementById('errorMessage').style.display = 'block';
        }
        
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                localStorage.removeItem('studentData');
                localStorage.removeItem('studentSession');
                window.location.href = '/student-login.html';
            }
        }
        
        // Load dashboard when page loads
        window.addEventListener('DOMContentLoaded', loadStudentDashboard);
        
        // Auto-logout after 24 hours
        setInterval(() => {
            const sessionTime = localStorage.getItem('studentSession');
            if (sessionTime) {
                const sessionAge = Date.now() - parseInt(sessionTime);
                if (sessionAge > 24 * 60 * 60 * 1000) {
                    localStorage.removeItem('studentData');
                    localStorage.removeItem('studentSession');
                    window.location.href = '/student-login.html';
                }
            }
        }, 60 * 60 * 1000); // Check every hour
    </script>

    <!-- NUCLEAR PHYSICS MODULE SCRIPT -->
    <script>
        // =============================================
