        // Content generators for Nuclear Physics
        function getPhysicsWelcomeContent() {
            currentPhysicsSection = 'welcome';
            return `
            <div style="text-align: center; padding: 2rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem;">⚛️</div>
                <h2 style="color: #2563eb; margin-bottom: 1rem;">MDCAT Nuclear Physics</h2>
