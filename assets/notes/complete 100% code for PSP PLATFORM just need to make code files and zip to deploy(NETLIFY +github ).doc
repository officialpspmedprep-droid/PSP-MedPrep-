        function solveWithAI() {
            const problem = document.getElementById('problemInput').value.trim();
            if (!problem) return;
            
            showLoading();
            
            setTimeout(() => {
                hideLoading();
                showResults();
                
                // AI-powered analysis
                const analysis = analyzeProblemWithAI(problem);
                
                document.getElementById('solutionSteps').innerHTML = `
                    <h4 style="color: #7c3aed; margin-bottom: 1rem;">🧠 AI-Powered Analysis</h4>
                    <p><strong>Problem:</strong> ${problem}</p>
                    <div style="background: white; padding: 1rem; border-radius: 8px; margin: 1rem 0;">
                        ${analysis.steps}
                    </div>
                    <p><strong>AI Confidence:</strong> <span style="color: #059669;">${analysis.confidence}%</span></p>
                `;
                
                document.getElementById('numericalAnswer').innerHTML = analysis.numericalAnswer;
                document.getElementById('conceptInfo').innerHTML = analysis.conceptInfo;
                
            }, 2500);
        }

        // =============================================
        // AI SOLVER ENGINE
        // =============================================
        function analyzeProblemWithAI(problem) {
            let analysis = {
                confidence: 95,
                steps: '',
                numericalAnswer: '',
                conceptInfo: ''
            };

            problem = problem.toLowerCase();

            // Half-life problems
            if (problem.includes('half-life') || problem.includes('half life')) {
                analysis.steps = `
                    <p><strong>Step 1:</strong> Identified as nuclear decay/half-life problem</p>
                    <p><strong>Step 2:</strong> Using formula: N = N₀ × (1/2)^(t/T)</p>
                    <p><strong>Step 3:</strong> Decay constant: λ = 0.693 / T</p>
                    <p><strong>Step 4:</strong> Activity: A = λN</p>
                `;
                analysis.numericalAnswer = calculateHalfLifeFromText(problem);
                analysis.conceptInfo = 'Radioactive decay follows first-order kinetics. Half-life is constant for each isotope.';
            }
            // Binding energy
            else if (problem.includes('binding energy')) {
                analysis.steps = `
                    <p><strong>Step 1:</strong> Identified as nuclear binding energy problem</p>
                    <p><strong>Step 2:</strong> Using Einstein\'s mass-energy equivalence: E = Δmc²</p>
                    <p><strong>Step 3:</strong> Mass defect calculation</p>
                    <p><strong>Step 4:</strong> Energy conversion (u to MeV)</p>
                `;
                analysis.numericalAnswer = 'Use E = Δm × 931.5 MeV/u';
                analysis.conceptInfo = 'Binding energy is the energy required to disassemble a nucleus into its constituent protons and neutrons.';
            }
            // Radiation problems
            else if (problem.includes('alpha') || problem.includes('beta') || problem.includes('gamma')) {
                analysis.steps = `
                    <p><strong>Step 1:</strong> Identified as radiation properties problem</p>
                    <p><strong>Step 2:</strong> Alpha: helium nucleus (2p+2n), stopped by paper</p>
                    <p><strong>Step 3:</strong> Beta: high-speed electron, stopped by aluminum</p>
                    <p><strong>Step 4:</strong> Gamma: electromagnetic radiation, stopped by lead</p>
                `;
                analysis.numericalAnswer = 'Penetration: α < β < γ';
                analysis.conceptInfo = 'Radiation types differ in mass, charge, and penetrating power.';
            }
            // General nuclear physics
            else {
                analysis.steps = `
                    <p><strong>Step 1:</strong> General nuclear physics problem detected</p>
                    <p><strong>Step 2:</strong> Analyzing nuclear properties and formulas</p>
                    <p><strong>Step 3:</strong> Applying relevant nuclear physics principles</p>
                    <p><strong>Step 4:</strong> Computational solution generation</p>
                `;
                analysis.numericalAnswer = 'Solution requires specific computational analysis';
                analysis.conceptInfo = 'Nuclear physics involves nuclear structure, forces, and radioactive processes.';
            }

            return analysis;
        }

        function autoCalculateProblem(problem) {
            problem = problem.toLowerCase();
            let numericalAnswer = '';
            let conceptInfo = '';

            // Extract numbers from problem
            const numbers = problem.match(/\d+\.?\d*/g) || [];
            const nums = numbers.map(Number);

            if ((problem.includes('half-life') || problem.includes('decay')) && nums.length >= 3) {
                // Example: "100g to 25g in 60 days"
                const initial = nums[0];
                const final = nums[1];
                const time = nums[2];
                
                if (initial > final) {
                    const halfLives = Math.log2(initial / final);
                    const halfLife = time / halfLives;
                    const decayConstant = 0.693 / halfLife;
                    
                    numericalAnswer = `
                        <strong>Calculation:</strong><br>
                        Half-lives (n) = log₂(${initial}/${final}) = ${halfLives.toFixed(2)}<br>
                        Half-life (T) = ${time} / ${halfLives.toFixed(2)} = ${halfLife.toFixed(2)} units<br>
                        Decay constant (λ) = 0.693 / ${halfLife.toFixed(2)} = ${decayConstant.toFixed(4)} units⁻¹
                    `;
                    conceptInfo = 'Radioactive decay: N = N₀(1/2)^(t/T)';
                }
            }
            else if (problem.includes('decay constant') && nums.length >= 1) {
                const halfLife = nums[0];
                const decayConstant = 0.693 / halfLife;
                
                numericalAnswer = `Decay constant (λ) = ${decayConstant.toFixed(4)} units⁻¹`;
                conceptInfo = 'λ = 0.693 / T (half-life)';
            }
            else {
                numericalAnswer = 'Enter specific numerical values for calculation';
                conceptInfo = 'General nuclear physics concept';
            }

            document.getElementById('numericalAnswer').innerHTML = numericalAnswer;
            document.getElementById('conceptInfo').innerHTML = conceptInfo;
        }

        function calculateHalfLifeFromText(problem) {
            const numbers = problem.match(/\d+\.?\d*/g) || [];
            const nums = numbers.map(Number);
            
            if (nums.length >= 3) {
                const initial = nums[0];
                const final = nums[1];
                const time = nums[2];
                
                if (initial && final && time && initial > final) {
                    const halfLives = Math.log2(initial / final);
                    const halfLife = time / halfLives;
                    const decayConstant = 0.693 / halfLife;
                    
                    return `
                        <strong>Calculation:</strong><br>
                        Half-lives (n) = log₂(${initial}/${final}) = ${halfLives.toFixed(2)}<br>
                        Half-life (T) = ${time} / ${halfLives.toFixed(2)} = ${halfLife.toFixed(2)} units<br>
                        Decay constant (λ) = 0.693 / ${halfLife.toFixed(2)} = ${decayConstant.toFixed(4)} units⁻¹
                    `;
                }
            }
            
            return 'Enter numerical values for automatic calculation';
        }

        // =============================================
        // UTILITY FUNCTIONS FOR AI SOLVER
        // =============================================
        function showLoading() {
            document.getElementById('loadingIndicator').style.display = 'block';
            document.getElementById('resultsSection').style.display = 'none';
            document.getElementById('resourcesSection').style.display = 'none';
        }

        function hideLoading() {
            document.getElementById('loadingIndicator').style.display = 'none';
        }

        function showResults() {
            document.getElementById('resultsSection').style.display = 'block';
        }

        function showMoreResources() {
            const problem = document.getElementById('problemInput').value.trim();
            showGoogleResources(problem);
            document.getElementById('resourcesSection').style.display = 'block';
        }

        function showGoogleResources(problem) {
            const query = encodeURIComponent(`nuclear physics ${problem}`);
            
            document.getElementById('resourceLinks').innerHTML = `
                <div style="background: #f0f7ff; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #2563eb;">📖 Educational Resources</h4>
                    <a href="https://www.khanacademy.org/science/physics/quantum-physics#nuclear-physics" target="_blank" style="color: #2563eb; text-decoration: none;">• Khan Academy - Nuclear Physics</a><br>
                    <a href="https://physics.info/nuclear/" target="_blank" style="color: #2563eb; text-decoration: none;">• Physics.info - Nuclear Physics</a><br>
                    <a href="https://www.britannica.com/science/nuclear-physics" target="_blank" style="color: #2563eb; text-decoration: none;">• Britannica - Nuclear Physics</a>
                </div>
                
                <div style="background: #f0fdf4; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #059669;">🔬 Research Papers</h4>
                    <a href="https://scholar.google.com/scholar?q=${query}" target="_blank" style="color: #2563eb; text-decoration: none;">• Google Scholar Search</a><br>
                    <a href="https://arxiv.org/list/physics.nucl/new" target="_blank" style="color: #2563eb; text-decoration: none;">• arXiv Nuclear Physics</a><br>
                    <a href="https://www.ncbi.nlm.nih.gov/pmc/?term=nuclear+physics" target="_blank" style="color: #2563eb; text-decoration: none;">• PubMed Central</a>
                </div>
                
                <div style="background: #faf5ff; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #7c3aed;">🎓 University Resources</h4>
                    <a href="https://ocw.mit.edu/courses/physics/8-701-introduction-to-nuclear-and-particle-physics-fall-2020/" target="_blank" style="color: #2563eb; text-decoration: none;">• MIT OpenCourseWare</a><br>
                    <a href="https://www.coursera.org/learn/particle-physics" target="_blank" style="color: #2563eb; text-decoration: none;">• Coursera - Particle Physics</a><br>
                    <a href="https://www.edx.org/learn/nuclear-physics" target="_blank" style="color: #2563eb; text-decoration: none;">• edX Nuclear Physics</a>
                </div>
                
                <div style="background: #fffbeb; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #d97706;">🧮 Calculation Tools</h4>
                    <a href="https://www.wolframalpha.com/" target="_blank" style="color: #2563eb; text-decoration: none;">• Wolfram Alpha</a><br>
                    <a href="https://www.symbolab.com/" target="_blank" style="color: #2563eb; text-decoration: none;">• Symbolab</a><br>
                    <a href="https://www.desmos.com/scientific" target="_blank" style="color: #2563eb; text-decoration: none;">• Desmos Scientific</a>
                </div>
            `;
        }

        function insertExample(type) {
            const examples = {
                'half-life': 'A radioactive sample decays from 800g to 100g in 90 days. Calculate the half-life.',
                'decay': 'Carbon-14 has a half-life of 5730 years. Calculate its decay constant.',
                'binding': 'Calculate the binding energy of uranium-235 nucleus.',
                'radiation': 'Compare the penetrating power of alpha, beta, and gamma radiation.',
                'mcq': 'Which statement about radioactive decay is correct? A) We can predict when a specific atom will decay B) Half-life can be changed by temperature C) Radioactive decay follows first-order kinetics D) All radioactive elements completely decay after 10 half-lives'
            };
            
            document.getElementById('problemInput').value = examples[type] || '';
        }

        // =============================================
        // STYLES FOR BOTH MODULES
        // =============================================
        // Add CSS styles dynamically
        const physicsStyles = `
        .quick-card {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 1.5rem;
            border: 1px solid #e5e7eb;
        }

        .calculator-input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .calculator-input:focus {
            border-color: #2563eb;
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        /* Animation for loading */
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        .loading-pulse {
            animation: pulse 2s infinite;
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .quick-actions {
                grid-template-columns: 1fr;
            }
            
            .quick-card {
                padding: 1.5rem;
            }
        }
        `;

        // Inject styles
        const styleElement = document.createElement('style');
        styleElement.textContent = physicsStyles;
        document.head.appendChild(styleElement);
    </script>
</body>
</html>
```


