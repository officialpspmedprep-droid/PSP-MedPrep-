        }

        function showPhysicsSection(section) {
            currentPhysicsSection = section;
            let content = '';
            
            switch(section) {
                case 'composition':
                    content = getCompositionContent();
                    break;
                case 'decay':
                    content = getDecayContent();
                    break;
                case 'half-life':
                    content = getHalfLifeContent();
                    break;
                case 'radiation':
                    content = getRadiationContent();
                    break;
                case 'calculator':
                    content = getCalculatorContent();
                    break;
                default:
                    content = getPhysicsWelcomeContent();
            }
            
            document.getElementById('physicsContent').innerHTML = content;
        }

        function getCompositionContent() {
            return `
            <div class="quick-card" style="text-align: left;">
                <h2 style="color: #2563eb; margin-bottom: 1.5rem;">1. Composition of Atomic Nucleus</h2>
                
                <div style="background: #f0f7ff; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #2563eb;">🎯 Key Concepts</h4>
                    <ul style="margin: 1rem 0; padding-left: 1.5rem;">
                        <li><strong>Proton:</strong> +1 charge, 1 u mass, found in nucleus</li>
                        <li><strong>Neutron:</strong> 0 charge, 1 u mass, found in nucleus</li>
                        <li><strong>Electron:</strong> -1 charge, 1/1840 u mass, orbits nucleus</li>
                        <li><strong>Atomic Number (Z):</strong> Number of protons (defines element)</li>
                        <li><strong>Mass Number (A):</strong> Protons + Neutrons (nucleons)</li>
                        <li><strong>Isotopes:</strong> Same Z, different A (different neutrons)</li>
                    </ul>
                </div>

                <div style="background: #f0fdf4; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #059669;">📝 Nuclear Notation</h4>
                    <div style="text-align: center; font-family: monospace; font-size: 1.5rem; margin: 1rem 0; padding: 1rem; background: white; border-radius: 8px;">
                        <sup>A</sup><sub>Z</sub>X
                    </div>
                    <p>Where X = element symbol, A = mass number, Z = atomic number</p>
                    <p><strong>Example:</strong> <sup>12</sup><sub>6</sub>C has 6 protons and 6 neutrons</p>
                </div>

                <div style="background: #faf5ff; padding: 1.5rem; border-radius: 10px;">
                    <h4 style="color: #7c3aed;">📊 Nuclear Properties</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin-top: 1rem;">
                        <div style="background: white; padding: 1rem; border-radius: 8px;">
                            <strong>Size:</strong> 10⁻¹⁴ to 10⁻¹⁵ m
                        </div>
                        <div style="background: white; padding: 1rem; border-radius: 8px;">
                            <strong>Density:</strong> ~2.3 × 10¹⁷ kg/m³
                        </div>
                        <div style="background: white; padding: 1rem; border-radius: 8px;">
                            <strong>Mass Unit:</strong> 1 u = 1.66 × 10⁻²⁷ kg
                        </div>
                        <div style="background: white; padding: 1rem; border-radius: 8px;">
                            <strong>Radius:</strong> R = R₀A¹/³
                        </div>
                    </div>
                </div>
            </div>
            `;
        }

        function getDecayContent() {
            return `
            <div class="quick-card" style="text-align: left;">
                <h2 style="color: #2563eb; margin-bottom: 1.5rem;">2. Radioactive Decay</h2>
                
                <div style="background: #fef3c7; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #d97706;">⚠️ MDCAT Traps & Truths</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                        <div style="background: #fecaca; padding: 1rem; border-radius: 8px;">
                            <strong>❌ FALSE Statements</strong>
                            <ul style="margin: 0.5rem 0; padding-left: 1.2rem;">
                                <li>We can predict when a specific atom will decay</li>
                                <li>Half-life can be changed by temperature</li>
                                <li>Radioactive element completely decays</li>
                                <li>Chemical reactions affect decay rate</li>
                            </ul>
                        </div>
                        <div style="background: #bbf7d0; padding: 1rem; border-radius: 8px;">
                            <strong>✅ TRUE Statements</strong>
                            <ul style="margin: 0.5rem 0; padding-left: 1.2rem;">
                                <li>Decay is random for individual atoms</li>
                                <li>Half-life is constant for each isotope</li>
                                <li>Decay follows first-order kinetics</li>
                                <li>Activity depends on amount of substance</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div style="background: #f0f7ff; padding: 1.5rem; border-radius: 10px;">
                    <h4 style="color: #2563eb;">📈 Exponential Decay Law</h4>
                    <div style="text-align: center; font-family: monospace; font-size: 1.3rem; margin: 1rem 0; padding: 1rem; background: white; border-radius: 8px;">
                        N = N₀e^(-λt)
                    </div>
                    <p>Where: N = remaining atoms, N₀ = initial atoms, λ = decay constant, t = time</p>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
                        <div style="text-align: center;">
                            <strong>Decay Constant (λ)</strong>
                            <p>Probability of decay per unit time</p>
                        </div>
                        <div style="text-align: center;">
                            <strong>Half-Life (T₁/₂)</strong>
                            <p>T₁/₂ = ln(2)/λ = 0.693/λ</p>
                        </div>
                        <div style="text-align: center;">
                            <strong>Activity (A)</strong>
                            <p>A = λN = A₀e^(-λt)</p>
                        </div>
                    </div>
                </div>
            </div>
            `;
        }

        function getHalfLifeContent() {
            return `
            <div class="quick-card" style="text-align: left;">
                <h2 style="color: #2563eb; margin-bottom: 1.5rem;">3. Half-Life & Calculations</h2>
                
                <div style="background: #faf5ff; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #7c3aed;">🧠 Key Formula</h4>
                    <div style="text-align: center; font-family: monospace; font-size: 1.3rem; margin: 1rem 0; padding: 1rem; background: white; border-radius: 8px;">
                        N = N₀ × (1/2)^(t/T)
                    </div>
                    <p>Where: N = final amount, N₀ = initial amount, t = time, T = half-life</p>
                </div>

                <div style="background: #f0fdf4; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #059669;">📊 Quick Reference Table</h4>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; margin: 1rem 0;">
                            <thead>
                                <tr style="background: #2563eb; color: white;">
                                    <th style="padding: 0.75rem; text-align: left;">Half-Lives</th>
                                    <th style="padding: 0.75rem; text-align: left;">Fraction Left</th>
                                    <th style="padding: 0.75rem; text-align: left;">% Remaining</th>
                                    <th style="padding: 0.75rem; text-align: left;">% Decayed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e5e7eb;"><td>0</td><td>1</td><td>100%</td><td>0%</td></tr>
                                <tr style="border-bottom: 1px solid #e5e7eb;"><td>1</td><td>1/2</td><td>50%</td><td>50%</td></tr>
                                <tr style="border-bottom: 1px solid #e5e7eb;"><td>2</td><td>1/4</td><td>25%</td><td>75%</td></tr>
                                <tr style="border-bottom: 1px solid #e5e7eb;"><td>3</td><td>1/8</td><td>12.5%</td><td>87.5%</td></tr>
                                <tr style="border-bottom: 1px solid #e5e7eb;"><td>4</td><td>1/16</td><td>6.25%</td><td>93.75%</td></tr>
                                <tr><td>5</td><td>1/32</td><td>3.125%</td><td>96.875%</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="background: #fffbeb; padding: 1.5rem; border-radius: 10px;">
                    <h4 style="color: #d97706;">💡 Problem Solving Strategy</h4>
                    <ol style="margin: 1rem 0; padding-left: 1.5rem;">
                        <li><strong>Identify known values:</strong> N₀, N, t, T</li>
                        <li><strong>Count half-lives:</strong> How many times it halves</li>
                        <li><strong>Use formula:</strong> N = N₀ × (1/2)^n</li>
                        <li><strong>Calculate:</strong> Solve for unknown variable</li>
                        <li><strong>Verify:</strong> Check if answer makes sense</li>
                    </ol>
                    
                    <div style="background: white; padding: 1rem; border-radius: 8px; margin-top: 1rem;">
                        <strong>Example:</strong> 800g → 400g → 200g → 100g = 3 half-lives
                    </div>
                </div>
            </div>
            `;
        }

        function getRadiationContent() {
            return `
            <div class="quick-card" style="text-align: left;">
                <h2 style="color: #2563eb; margin-bottom: 1.5rem;">4. Radiation Types & Properties</h2>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="background: #fef3c7; padding: 1.5rem; border-radius: 10px; border-left: 4px solid #d97706;">
                        <h4 style="color: #d97706; margin-bottom: 1rem;">α Radiation</h4>
                        <p><strong>Composition:</strong> Helium nucleus (2 protons + 2 neutrons)</p>
