                    <button onclick="showPhysicsSection('decay')" class="btn ${currentPhysicsSection === 'decay' ? 'btn-view' : ''}" style="padding: 0.8rem;">2. Nuclear Decay</button>
                    <button onclick="showPhysicsSection('half-life')" class="btn ${currentPhysicsSection === 'half-life' ? 'btn-view' : ''}" style="padding: 0.8rem;">3. Half-Life</button>
                    <button onclick="showPhysicsSection('radiation')" class="btn ${currentPhysicsSection === 'radiation' ? 'btn-view' : ''}" style="padding: 0.8rem;">4. Radiation Types</button>
                    <button onclick="showPhysicsSection('calculator')" class="btn ${currentPhysicsSection === 'calculator' ? 'btn-view' : ''}" style="padding: 0.8rem;">🧮 Calculators</button>
                </div>

                <!-- Content Area -->
                <div id="physicsContent">
                    ${getPhysicsWelcomeContent()}
                </div>

                <!-- PSP Footer -->
                <div style="text-align: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #e5e7eb;">
                    <p style="color: #6b7280;">PSP MedPrep 🇵🇰 Platform - Nuclear Physics Module</p>
                </div>
            </div>
            `;
            
            document.getElementById('nuclearPhysicsContent').innerHTML = content;
