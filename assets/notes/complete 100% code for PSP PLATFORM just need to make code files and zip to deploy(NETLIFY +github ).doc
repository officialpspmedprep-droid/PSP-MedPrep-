        // Global variables to track module state
        let currentPhysicsSection = 'welcome';

        // Main loader functions
        function loadNuclearPhysics() {
            // Hide AI solver if open
            document.getElementById('aiSolverContent').style.display = 'none';
            document.getElementById('dashboardContent').style.display = 'none';
            
            // Show physics content
            document.getElementById('nuclearPhysicsContent').style.display = 'block';
            
            // Load the module
            renderNuclearPhysicsModule();
            
            // Scroll to content
            document.getElementById('nuclearPhysicsContent').scrollIntoView({ behavior: 'smooth' });
        }

        function loadAISolver() {
            // Hide physics content if open
            document.getElementById('nuclearPhysicsContent').style.display = 'none';
            document.getElementById('dashboardContent').style.display = 'none';
            
            // Show AI solver
            document.getElementById('aiSolverContent').style.display = 'block';
            
            // Load the AI solver
            renderAISolverModule();
            
            // Scroll to content
            document.getElementById('aiSolverContent').scrollIntoView({ behavior: 'smooth' });
        }

        function backToDashboard() {
            // Show dashboard, hide modules
            document.getElementById('nuclearPhysicsContent').style.display = 'none';
            document.getElementById('aiSolverContent').style.display = 'none';
            document.getElementById('dashboardContent').style.display = 'block';
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Nuclear Physics Module Renderer
        function renderNuclearPhysicsModule() {
            const content = `
