                    <div style="background: white; padding: 1rem; border-radius: 8px; margin: 1rem 0;">
                        <p><strong>Step 1:</strong> Problem analyzed using computational intelligence</p>
                        <p><strong>Step 2:</strong> Nuclear physics parameters identified</p>
                        <p><strong>Step 3:</strong> Mathematical solution computed</p>
                        <p><strong>Step 4:</strong> Result verified against known constants</p>
                    </div>
                    <p><em>For detailed step-by-step solution, visit:</em></p>
                    <a href="https://www.wolframalpha.com/input?i=${wolframQuery}" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: bold;">
                        🔗 Open in Wolfram Alpha
                    </a>
                `;
                
                // Auto-calculate if it's a numerical problem
