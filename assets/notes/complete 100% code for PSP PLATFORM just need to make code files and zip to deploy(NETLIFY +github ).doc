        function getCalculatorContent() {
            return `
            <div class="quick-card" style="text-align: left;">
                <h2 style="color: #2563eb; margin-bottom: 1.5rem;">🧮 Nuclear Physics Calculators</h2>
                
                <!-- Half-Life Calculator -->
                <div style="background: #f0f7ff; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #2563eb;">⏰ Half-Life Calculator</h4>
                    <p>Enter any three values to calculate the fourth:</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0;">
                        <input type="number" id="hlInitial" placeholder="Initial Amount (N₀)" class="calculator-input">
                        <input type="number" id="hlFinal" placeholder="Final Amount (N)" class="calculator-input">
                        <input type="number" id="hlTime" placeholder="Time Elapsed (t)" class="calculator-input">
                        <input type="number" id="hlHalfLife" placeholder="Half-Life (T)" class="calculator-input">
                    </div>
                    
                    <button onclick="calculateHalfLife()" class="cta-button" style="width: 100%;">Calculate</button>
                    <div id="hlResult" style="margin-top: 1rem; padding: 1rem; background: white; border-radius: 8px; display: none;"></div>
                </div>

                <!-- Decay Constant Calculator -->
                <div style="background: #f0fdf4; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <h4 style="color: #059669;">📈 Decay Constant Calculator</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0;">
                        <input type="number" id="dcHalfLife" placeholder="Half-Life (T)" class="calculator-input">
                        <input type="number" id="dcTime" placeholder="Time (t)" class="calculator-input">
                        <input type="number" id="dcInitial" placeholder="Initial Amount (N₀)" class="calculator-input">
                    </div>
                    <button onclick="calculateDecayConstant()" class="cta-button" style="width: 100%; background: #059669;">Calculate Decay</button>
                    <div id="dcResult" style="margin-top: 1rem; padding: 1rem; background: white; border-radius: 8px; display: none;"></div>
                </div>

                <!-- Binding Energy Calculator -->
                <div style="background: #faf5ff; padding: 1.5rem; border-radius: 10px;">
                    <h4 style="color: #7c3aed;">⚡ Binding Energy Calculator</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0;">
                        <input type="number" id="beProtons" placeholder="Number of Protons (Z)" class="calculator-input">
                        <input type="number" id="beNeutrons" placeholder="Number of Neutrons (N)" class="calculator-input">
                        <input type="number" id="beMass" placeholder="Nuclear Mass (u)" class="calculator-input" step="0.0001">
                    </div>
                    <button onclick="calculateBindingEnergy()" class="cta-button" style="width: 100%; background: #7c3aed;">Calculate Binding Energy</button>
                    <div id="beResult" style="margin-top: 1rem; padding: 1rem; background: white; border-radius: 8px; display: none;"></div>
                </div>
            </div>
            `;
        }

        // Calculator Functions
        function calculateHalfLife() {
            const initial = parseFloat(document.getElementById('hlInitial').value);
            const final = parseFloat(document.getElementById('hlFinal').value);
            const time = parseFloat(document.getElementById('hlTime').value);
            const halfLife = parseFloat(document.getElementById('hlHalfLife').value);
            
            let result = '';
            let filled = [initial, final, time, halfLife].filter(x => !isNaN(x)).length;
            
            if (filled < 3) {
                result = '<div style="color: #dc2626; font-weight: bold;">❌ Please enter at least three values</div>';
            } else {
                if (isNaN(initial)) {
                    const n = time / halfLife;
                    const calcInitial = final / Math.pow(0.5, n);
                    result = `
                        <div style="color: #059669;">
                            <strong>✅ Initial Amount (N₀) = ${calcInitial.toFixed(2)}</strong><br>
                            <small>Calculation: N₀ = N / (1/2)^(t/T) = ${final} / (1/2)^(${time}/${halfLife})</small>
                        </div>
                    `;
                } else if (isNaN(final)) {
                    const n = time / halfLife;
                    const calcFinal = initial * Math.pow(0.5, n);
                    result = `
                        <div style="color: #059669;">
                            <strong>✅ Final Amount (N) = ${calcFinal.toFixed(2)}</strong><br>
                            <small>Calculation: N = N₀ × (1/2)^(t/T) = ${initial} × (1/2)^(${time}/${halfLife})</small>
                        </div>
                    `;
                } else if (isNaN(time)) {
                    const ratio = final / initial;
                    const calcTime = halfLife * (Math.log(ratio) / Math.log(0.5));
                    result = `
                        <div style="color: #059669;">
                            <strong>✅ Time Elapsed = ${calcTime.toFixed(2)}</strong><br>
                            <small>Calculation: t = T × log(N/N₀) / log(1/2) = ${halfLife} × log(${final}/${initial}) / log(0.5)</small>
                        </div>
                    `;
                } else if (isNaN(halfLife)) {
                    const ratio = final / initial;
                    const calcHalfLife = time / (Math.log(ratio) / Math.log(0.5));
                    result = `
                        <div style="color: #059669;">
                            <strong>✅ Half-Life = ${calcHalfLife.toFixed(2)}</strong><br>
                            <small>Calculation: T = t / [log(N/N₀) / log(1/2)] = ${time} / [log(${final}/${initial}) / log(0.5)]</small>
                        </div>
                    `;
                }
                
                result += '<p style="margin-top: 0.5rem;"><strong>📚 Formula used:</strong> N = N₀(1/2)^(t/T)</p>';
            }
            
            document.getElementById('hlResult').innerHTML = result;
            document.getElementById('hlResult').style.display = 'block';
        }

        function calculateDecayConstant() {
            const halfLife = parseFloat(document.getElementById('dcHalfLife').value);
            const time = parseFloat(document.getElementById('dcTime').value);
            const initial = parseFloat(document.getElementById('dcInitial').value);
            
            if (!halfLife) {
                document.getElementById('dcResult').innerHTML = '<div style="color: #dc2626; font-weight: bold;">❌ Please enter half-life</div>';
                document.getElementById('dcResult').style.display = 'block';
                return;
            }
            
            const decayConstant = 0.693 / halfLife;
            let result = `
                <div style="color: #059669;">
                    <strong>✅ Decay Constant (λ) = ${decayConstant.toFixed(6)}</strong><br>
                    <small>Formula: λ = 0.693 / T = 0.693 / ${halfLife}</small>
                </div>
            `;
            
            if (!isNaN(time) && !isNaN(initial)) {
                const remaining = initial * Math.exp(-decayConstant * time);
                const decayed = initial - remaining;
                const percentage = (decayed / initial) * 100;
                
                result += `
                    <div style="margin-top: 1rem;">
                        <strong>📊 After ${time} time units:</strong><br>
                        • Remaining: ${remaining.toFixed(2)} (${(100-percentage).toFixed(1)}%)<br>
                        • Decayed: ${decayed.toFixed(2)} (${percentage.toFixed(1)}%)<br>
                        <small>Using: N = N₀e^(-λt)</small>
                    </div>
                `;
            }
            
            document.getElementById('dcResult').innerHTML = result;
            document.getElementById('dcResult').style.display = 'block';
        }

        function calculateBindingEnergy() {
            const protons = parseInt(document.getElementById('beProtons').value);
            const neutrons = parseInt(document.getElementById('beNeutrons').value);
            const mass = parseFloat(document.getElementById('beMass').value);
            
            if (isNaN(protons) || isNaN(neutrons) || isNaN(mass)) {
                document.getElementById('beResult').innerHTML = '<div style="color: #dc2626; font-weight: bold;">❌ Please enter all values</div>';
                document.getElementById('beResult').style.display = 'block';
                return;
            }
            
            const massProton = 1.007276; // u
            const massNeutron = 1.008665; // u
            const massElectron = 0.000549; // u
            
            // Calculate expected mass
            const expectedMass = (protons * massProton) + (neutrons * massNeutron) - (protons * massElectron);
            
            // Mass defect
            const massDefect = expectedMass - mass;
            
            // Binding energy (1 u = 931.5 MeV)
            const bindingEnergy = massDefect * 931.5;
            
            // Binding energy per nucleon
            const nucleons = protons + neutrons;
            const bindingEnergyPerNucleon = bindingEnergy / nucleons;
            
            document.getElementById('beResult').innerHTML = `
                <div style="color: #7c3aed;">
                    <strong>✅ Binding Energy Results:</strong><br>
                    • Mass Defect: ${massDefect.toFixed(6)} u<br>
                    • Total Binding Energy: ${bindingEnergy.toFixed(2)} MeV<br>
                    • Binding Energy per Nucleon: ${bindingEnergyPerNucleon.toFixed(3)} MeV/nucleon<br>
                    <small>Formula: E = Δm × 931.5 MeV/u</small>
                </div>
            `;
            document.getElementById('beResult').style.display = 'block';
        }

        // AI Solver Functions
